{
  "name": "deepseek-harness-studio",
  "version": "0.2.0",
  "description": "A local desktop distribution of the official DeepSeek Harness Web UI",
  "type": "module",
  "main": "src/main.mjs",
  "license": "MIT",
  "private": true,
  "author": "DeepSeek Harness Studio contributors",
  "studioUpdateUrl": "",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare:runtime": "node scripts/prepare-node-runtime.mjs",
    "start": "pnpm run prepare:runtime && electron .",
    "postinstall": "install-electron",
    "test": "node --test",
    "smoke:service": "node scripts/smoke-service.mjs",
    "pack:win": "pnpm run prepare:runtime && electron-builder --config electron-builder.config.mjs --win dir --x64",
    "dist:win": "pnpm run prepare:runtime && electron-builder --config electron-builder.config.mjs --win nsis --x64",
    "dist:mac": "pnpm run prepare:runtime && electron-builder --config electron-builder.config.mjs --mac dmg zip --arm64",
    "dist": "pnpm run prepare:runtime && electron-builder --config electron-builder.config.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.6",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.6",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-output-retention": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-title-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.6",
    "@deepseek-ai/dsh-spill": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-workflow": "0.1.0-rc.6",
    "electron-updater": "6.8.9",
    "pnpm": "11.21.0"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  }
}
